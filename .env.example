# URL direta da API (use quando a API estiver em outra máquina da rede)
# VITE_API_URL=http://192.168.1.100:8080

# Alvo do proxy do Vite em desenvolvimento (API em outra máquina, app local)
# VITE_API_PROXY_TARGET=http://192.168.1.100:8080

# Se VITE_API_URL não estiver definido, em dev o app usa o proxy local (localhost:8080)
